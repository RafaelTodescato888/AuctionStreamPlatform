{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "Consumer": {
      "RetryTopicSuffix": "-retry",
      "DeadLetterTopicSuffix": "-dlq",
      "Config": {
        "BootstrapServers": "localhost:9092",
        "AutoOffsetReset": "Earliest",
        "EnableAutoCommit": false,
        "EnableAutoOffsetStore": false
      }
    },
    "Producer": {
      "RetryTopicSuffix": "-retry",
      "DeadLetterTopicSuffix": "-dlq",
      "Config": {
        "BootstrapServers": "localhost:9092",
        "ClientId": "my-application",
        "Acks": "All",
        "EnableIdempotence": true,
        "MessageTimeoutMs": 30000
      },
      "FlushTimeoutSeconds": 10
    },
    "Topics": {
      "AutoCreate": true,
      "Partitions": 3,
      "ReplicationFactor": 1
    }
  },
  "ConnectionStrings": {
    "USER_CONTEXT_DATA_SOURCE": ""
  },
  "LOKI_SERVICE_URL": "http://loki:3100",
  "OPEN_TELEMETRY_URL": "http://tempo:4317",
  "TokenGenerationConfig": {
    "MaxBytes": "",
    "LanesNumber": "",
    "MemorySize": "",
    "Iterations": "",
    "Hash": "",
    "JwtSecret": "",
    "DefaultExpiration": ""
  },
  "AdminCredentialsConfig": {
    "Name": "",
    "Email": "",
    "Document": "",
    "Password": ""
  },
  "LoginAttemptsConfig": {
    "MaxFailedLoginAttempts": 0
  }
}
